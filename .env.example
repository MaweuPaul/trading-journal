# Root .env - Python MT5 sync script
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# The local agent keeps only this installation secret. Add MT5 accounts from
# the journal's Accounts page; broker credentials are encrypted in MongoDB.
SYNC_SECRET=THE_SAME_LONG_RANDOM_VALUE_AS_BACKEND_SYNC_SECRET
API_BASE=http://localhost:4000/api
API_TIMEOUT=60
SYNC_INTERVAL=60

# One-time migration only. Existing installations may temporarily keep these,
# run `cd backend && npm run migrate:trading-account`, verify the Accounts page,
# then remove all legacy MT5_* and USER_* credential lines.
# MT5_LOGIN=YOUR_OLD_MT5_ACCOUNT_NUMBER
# MT5_PASSWORD=YOUR_OLD_MT5_PASSWORD
# MT5_SERVER=YOUR_OLD_MT5_SERVER
# MT5_REQUIRE_REAL_ACCOUNT=false
# MT5_SYMBOL_ALIASES=XAUUSD:XAUUSDm,USTEC:USTECm
