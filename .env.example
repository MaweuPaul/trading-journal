# Root .env - Python MT5 sync script
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

MT5_LOGIN=YOUR_MT5_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_MT5_SERVER_NAME
MT5_REQUIRE_REAL_ACCOUNT=false
# Optional only when a historical journal symbol differs from the connected
# broker's instrument name. Exact recorded symbols are always tried first.
# Example: MT5_SYMBOL_ALIASES=XAUUSD:XAUUSDm,USTEC:USTECm
MT5_SYMBOL_ALIASES=
API_BASE=http://localhost:4000/api
API_TIMEOUT=60
SYNC_INTERVAL=60
USER_EMAIL=YOUR_JOURNAL_OWNER_EMAIL
USER_PASSWORD=YOUR_JOURNAL_OWNER_PASSWORD
