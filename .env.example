# Root .env — Python MT5 Sync Script
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

MT5_LOGIN=YOUR_MT5_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_MT5_SERVER_NAME
API_BASE=http://localhost:4000/api
SYNC_INTERVAL=60
USER_EMAIL=YOUR_ADMIN_EMAIL
USER_PASSWORD=YOUR_ADMIN_PASSWORD

# Optional: explicit path to MT5 MQL5/Files directory
# Find it in MT5 → File → Open Data Folder → MQL5 → Files
# Example (Windows): C:\Users\YourName\AppData\Roaming\MetaQuotes\Terminal\YOUR_TERMINAL_ID\MQL5\Files
MT5_FILES_DIR=
