# Backend .env - Node.js Express API
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

PORT=4000
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
NODE_ENV=development
# Comma-separated list of exact frontend origins allowed to call this API.
# Defaults to http://localhost:3000 (the Next.js dev server) if unset.
ALLOWED_ORIGINS=http://localhost:3000
SYNC_SECRET=YOUR_SYNC_SECRET
JWT_SECRET=YOUR_JWT_SECRET_LONG_RANDOM_STRING
# Dedicated master secret for AES-256-GCM broker credential encryption.
# Generate once, keep it stable, and back it up securely. Changing it makes
# existing Trading Account credentials unreadable.
ACCOUNT_ENCRYPTION_KEY=YOUR_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional one-time owner creation. Leave false to create the owner at /signup.
SEED_OWNER_ENABLED=false
OWNER_NAME=YOUR_NAME
OWNER_EMAIL=you@example.com
# Used only for the OFFLINE login fallback (when MongoDB is unreachable).
# Prefer OWNER_PASSWORD_HASH (a bcrypt hash) so your real password is never
# stored in plaintext on disk. Generate one with:
#   node -e "require('bcryptjs').hash(process.argv[1],12).then(console.log)" "your-password"
# If both are set, OWNER_PASSWORD_HASH wins and OWNER_PASSWORD is ignored.
OWNER_PASSWORD=YOUR_SECURE_PASSWORD_MINIMUM_8_CHARACTERS
# OWNER_PASSWORD_HASH=$2a$12$REPLACE_WITH_YOUR_BCRYPT_HASH
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Trade Replay — candles come from the cTrader Open API, not MT5 or Twelve
# Data. Register a free app at https://openapi.ctrader.com to get these:
#   1. Create an app -> copy its Client ID and Client Secret below.
#   2. Set the app's Redirect URI to match CTRADER_REDIRECT_URI exactly
#      (this should be your frontend's Accounts page, e.g.
#      http://localhost:3000/accounts).
#   3. Start the app, open the Accounts page, click "Connect cTrader", and
#      authorize the one cTrader account you want Replay to read candles
#      from. This is a one-time step — the resulting tokens are stored
#      encrypted in MongoDB (see lib/credentialEncryption.js), the same way
#      MT5 broker credentials are.
CTRADER_CLIENT_ID=YOUR_CTRADER_OPEN_API_CLIENT_ID
CTRADER_CLIENT_SECRET=YOUR_CTRADER_OPEN_API_CLIENT_SECRET
CTRADER_REDIRECT_URI=http://localhost:3000/accounts
