# Backend .env - Node.js Express API
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

PORT=4000
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
NODE_ENV=development
SYNC_SECRET=YOUR_SYNC_SECRET
JWT_SECRET=YOUR_JWT_SECRET_LONG_RANDOM_STRING

# Optional one-time owner creation. Leave false to create the owner at /signup.
SEED_OWNER_ENABLED=false
OWNER_NAME=YOUR_NAME
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=YOUR_SECURE_PASSWORD_MINIMUM_8_CHARACTERS
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Trade Replay — create a personal key at https://twelvedata.com
TWELVE_DATA_API_KEY=YOUR_TWELVE_DATA_API_KEY
